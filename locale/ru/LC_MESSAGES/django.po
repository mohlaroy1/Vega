msgstr "Истёк срок"

msgid "Xabar berildi"
msgstr "Уведомлён"

msgid "Javob berdi"
msgstr "Ответил"

msgid "Rad etdi"
msgstr "Отказался"

msgid "Shifoxona nomi"
msgstr "Название больницы"

